{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
"moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["**/*.ts"],
 "exclude": ["generated"]
}